<Window x:Class="StarLead.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AppName}" Width="1120" Height="700" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        PreviewMouseMove="Window_PreviewMouseMove" PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp">
    <Window.Resources>
        <Style x:Key="KeyButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="82"/><Setter Property="Height" Value="82"/><Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="AllowDrop" Value="True"/><Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value></Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" CornerRadius="18" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="4">
                            <Grid>
                                <Image Source="{Binding Icon}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True">
                                    <Image.Style><Style TargetType="Image"><Setter Property="Width" Value="68"/><Setter Property="Height" Value="68"/><Setter Property="Margin" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding ShowLabel}" Value="True"><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="Width" Value="58"/><Setter Property="Height" Value="58"/></DataTrigger></Style.Triggers></Style></Image.Style>
                                </Image>
                                <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextBrush}" FontSize="11" FontWeight="Medium" TextTrimming="CharacterEllipsis" TextAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding ShowLabel}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                <TextBlock x:Name="EmptyKey" Text="{Binding Key}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.82"/>
                                <Border x:Name="BoundKeyBadge" Background="#A0111520" CornerRadius="7" Padding="5,1" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Key}" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True"><Setter TargetName="BoundKeyBadge" Property="Visibility" Value="Collapsed"/></DataTrigger>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="False"><Setter TargetName="EmptyKey" Property="Visibility" Value="Collapsed"/></DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Shell" Property="Effect"><Setter.Value><DropShadowEffect Color="#8B5CF6" BlurRadius="18" ShadowDepth="0" Opacity="0.46"/></Setter.Value></Setter>
                                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.05" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.05" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Shell" Property="BorderThickness" Value="2"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.8"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="Click" Handler="Slot_Click"/><EventSetter Event="MouseDoubleClick" Handler="Slot_DoubleClick"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Slot_MouseDown"/><EventSetter Event="Drop" Handler="Slot_Drop"/>
            <EventSetter Event="DragOver" Handler="Slot_DragOver"/>
            <EventSetter Event="PreviewMouseRightButtonUp" Handler="Slot_RightClick"/>
        </Style>
        <DataTemplate x:Key="KeyTemplate"><Button Style="{StaticResource KeyButtonStyle}" DataContext="{Binding}" AutomationProperties.Name="{Binding DisplayName}"/></DataTemplate>
        <Style x:Key="FixedEntryButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="56"/><Setter Property="Height" Value="56"/><Setter Property="Margin" Value="5,0"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="FixedShell" CornerRadius="16" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FixedShell" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="FixedShell" Property="Background" Value="{DynamicResource AccentSoftBrush}"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="FixedShell" Property="Opacity" Value="0.72"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="HeaderIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="48"/><Setter Property="Height" Value="48"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="5,0"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Circle" CornerRadius="24" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Circle" Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Circle" Property="Opacity" Value="0.7"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Circle" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ModePillButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="122"/><Setter Property="Height" Value="44"/><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ModeShell" CornerRadius="22" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ModeShell" Property="Background" Value="{DynamicResource AccentSoftBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ModeShell" Property="Opacity" Value="0.72"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="LinearIconStyle" TargetType="Button">
            <Setter Property="Width" Value="80"/><Setter Property="Height" Value="80"/><Setter Property="Margin" Value="{Binding LinearMargin}"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="7"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/><Setter Property="RenderTransform"><Setter.Value><ScaleTransform/></Setter.Value></Setter>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Grid x:Name="HoverHost" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><ScaleTransform x:Name="HoverScale" ScaleX="1" ScaleY="1"/></Grid.RenderTransform><Ellipse x:Name="Glow" Fill="{DynamicResource AccentSoftBrush}" Opacity="0"/><Image Source="{Binding Icon}" Stretch="Uniform" Margin="5,2,5,18" SnapsToDevicePixels="True"/><Border Background="#B0111520" CornerRadius="8" Padding="5,1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,1,0"><TextBlock Text="{Binding Key}" Foreground="White" FontSize="11" FontWeight="Bold"/></Border><TextBlock x:Name="LinearName" Text="{Binding DisplayName}" Foreground="{DynamicResource TextBrush}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" MaxWidth="72"/></Grid>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Glow" Property="Opacity" Value="1"/>
                    <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleX" To="1.16" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleY" To="1.16" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions>
                    <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions>
                </Trigger>
                    <DataTrigger Binding="{Binding ShowLabel}" Value="False"><Setter TargetName="LinearName" Property="Visibility" Value="Collapsed"/></DataTrigger>
                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True"><Setter TargetName="Glow" Property="Opacity" Value="1"/><DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.18" Duration="0:0:0.14"/><DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.18" Duration="0:0:0.14"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions><DataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.17"/><DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.17"/></Storyboard></BeginStoryboard></DataTrigger.ExitActions></DataTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
            <EventSetter Event="Click" Handler="LinearItem_Click"/><EventSetter Event="PreviewMouseLeftButtonDown" Handler="LinearItem_MouseDown"/>
            <EventSetter Event="PreviewMouseRightButtonUp" Handler="LinearItem_RightClick"/>
        </Style>
        <DataTemplate x:Key="LinearItemTemplate"><Button Style="{StaticResource LinearIconStyle}" DataContext="{Binding}"/></DataTemplate>
        <Style x:Key="InvisibleResizeThumbStyle" TargetType="Thumb">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Opacity" Value="0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="Transparent" BorderThickness="0"/></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Grid>
    <Border x:Name="PanelShell" Background="{DynamicResource PanelBrush}" CornerRadius="28" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="30">
        <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.26"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Background="Transparent" Height="72">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="64" Height="64" CornerRadius="18" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10">
                        <Image Source="{DynamicResource LogoAsset}" Stretch="Uniform" SnapsToDevicePixels="True"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="{DynamicResource AppName}" FontSize="26" FontWeight="Bold"/><TextBlock Text="{DynamicResource MainSubtitle}" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,4,0,0"/></StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Width="252" Height="52" CornerRadius="26" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="4" VerticalAlignment="Center">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Button x:Name="KeyboardModeButton" Grid.Column="0" Style="{StaticResource ModePillButtonStyle}" Content="{DynamicResource KeyboardPanel}" Click="KeyboardMode_Click" Background="{DynamicResource AccentBrush}" Foreground="White"/>
                        <Button x:Name="LinearModeButton" Grid.Column="1" Style="{StaticResource ModePillButtonStyle}" Content="{DynamicResource LinearPanel}" Click="LinearMode_Click"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="NameToggleButton" Style="{StaticResource HeaderIconButtonStyle}" Click="NameToggle_Click"><TextBlock Text="Aa" FontSize="15" FontWeight="Bold"/></Button>
                    <Button x:Name="PinButton" Style="{StaticResource HeaderIconButtonStyle}" Click="Pin_Click"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE840;" FontSize="18"/></Button>
                    <Button Style="{StaticResource HeaderIconButtonStyle}" Click="Settings_Click" ToolTip="{DynamicResource Settings}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="19"/></Button>
                </StackPanel>
            </Grid>

            <StackPanel x:Name="SystemEntriesPanel" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,8">
                <Button x:Name="MyComputerButton" Style="{StaticResource FixedEntryButtonStyle}" Click="MyComputer_Click"><Image x:Name="MyComputerIcon" Width="38" Height="38" Stretch="Uniform" SnapsToDevicePixels="True"/></Button>
                <Button x:Name="DownloadsButton" Style="{StaticResource FixedEntryButtonStyle}" Click="Downloads_Click"><Image x:Name="DownloadsIcon" Width="38" Height="38" Stretch="Uniform" SnapsToDevicePixels="True"/></Button>
                <Button x:Name="RecycleBinButton" Style="{StaticResource FixedEntryButtonStyle}" Click="RecycleBin_Click" PreviewMouseRightButtonUp="RecycleBin_RightClick"><Image x:Name="RecycleBinIcon" Width="38" Height="38" Stretch="Uniform" SnapsToDevicePixels="True"/></Button>
            </StackPanel>

            <Grid Grid.Row="2" VerticalAlignment="Center">
                <StackPanel>
                    <ItemsControl x:Name="Row1" ItemTemplate="{StaticResource KeyTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                    <ItemsControl x:Name="Row2" ItemTemplate="{StaticResource KeyTemplate}" Margin="20,0,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                    <ItemsControl x:Name="Row3" ItemTemplate="{StaticResource KeyTemplate}" Margin="-4,0,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                    <ItemsControl x:Name="Row4" ItemTemplate="{StaticResource KeyTemplate}" Margin="-38,0,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                </StackPanel>
            </Grid>
            <TextBlock Grid.Row="3" Text="{DynamicResource MainHint}" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,6,0,0"/>
        </Grid>
    </Border>
    <Border x:Name="LinearShell" Visibility="Collapsed" Background="{DynamicResource PanelBrush}" CornerRadius="24" BorderThickness="0" Padding="10"
            AllowDrop="True" Drop="LinearShell_Drop" DragOver="LinearShell_DragOver" PreviewMouseWheel="LinearShell_MouseWheel" PreviewMouseRightButtonUp="LinearShell_RightClick">
        <Grid>
            <ScrollViewer x:Name="LinearScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" PanningMode="HorizontalOnly">
                <ItemsControl x:Name="LinearItemsControl" ItemTemplate="{StaticResource LinearItemTemplate}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
            <Thumb x:Name="LinearLeftResize" Style="{StaticResource InvisibleResizeThumbStyle}" Width="9" HorizontalAlignment="Left" Cursor="SizeWE" DragDelta="LinearLeftResize_DragDelta"/>
            <Thumb x:Name="LinearRightResize" Style="{StaticResource InvisibleResizeThumbStyle}" Width="9" HorizontalAlignment="Right" Cursor="SizeWE" DragDelta="LinearRightResize_DragDelta"/>
        </Grid>
    </Border>
    </Grid>
</Window>
