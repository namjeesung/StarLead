<Window x:Class="StarLead.NoteEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource EditNote}" Width="620" Height="500" MinWidth="460" MinHeight="360" WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}">
    <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBox x:Name="TitleBox" FontSize="22" FontWeight="Bold" TextChanged="Editor_TextChanged"/>
        <TextBox x:Name="ContentBox" Grid.Row="2" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="15" TextChanged="Editor_TextChanged"/>
        <Grid Grid.Row="3" Margin="0,12,0,0"><TextBlock Text="{DynamicResource AutosaveLocal}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/><Button Content="{DynamicResource Done}" Click="Done_Click" HorizontalAlignment="Right" Padding="20,8" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0"/></Grid>
    </Grid>
</Window>
