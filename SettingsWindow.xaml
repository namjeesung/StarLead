<Window x:Class="StarLead.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource SettingsTitle}" Width="700" Height="650" MinHeight="560" WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
        <TextBlock Text="{DynamicResource Settings}" FontSize="28" FontWeight="Bold"/><TextBlock Text="{DynamicResource SettingsSubtitle}" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,24"/>
        <Border Background="{DynamicResource PanelBrush}" CornerRadius="18" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="20" Margin="0,0,0,16">
            <StackPanel><TextBlock Text="{DynamicResource Language}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/><StackPanel Orientation="Horizontal"><RadioButton x:Name="ChineseRadio" Content="{DynamicResource Chinese}" GroupName="Language" Margin="0,0,25,0" Foreground="{DynamicResource TextBrush}" Checked="Language_Checked"/><RadioButton x:Name="EnglishRadio" Content="{DynamicResource English}" GroupName="Language" Foreground="{DynamicResource TextBrush}" Checked="Language_Checked"/></StackPanel><TextBlock Text="{DynamicResource InstantApply}" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/></StackPanel>
        </Border>
        <Border Background="{DynamicResource PanelBrush}" CornerRadius="18" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="20" Margin="0,0,0,16">
            <StackPanel><TextBlock Text="{DynamicResource Appearance}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/><StackPanel Orientation="Horizontal"><RadioButton x:Name="LightRadio" Content="{DynamicResource Light}" GroupName="Theme" Margin="0,0,25,0" Foreground="{DynamicResource TextBrush}" Checked="Theme_Checked"/><RadioButton x:Name="DarkRadio" Content="{DynamicResource Dark}" GroupName="Theme" Foreground="{DynamicResource TextBrush}" Checked="Theme_Checked"/></StackPanel><TextBlock Text="{DynamicResource InstantApply}" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/></StackPanel>
        </Border>
        <Border Background="{DynamicResource PanelBrush}" CornerRadius="18" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="20" Margin="0,0,0,16">
            <StackPanel><TextBlock Text="{DynamicResource VisualStyle}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/><WrapPanel><RadioButton x:Name="LiquidGlassRadio" Content="{DynamicResource LiquidGlass}" GroupName="VisualStyle" Margin="0,0,22,8" Foreground="{DynamicResource TextBrush}" Checked="VisualStyle_Checked"/><RadioButton x:Name="OceanRadio" Content="{DynamicResource Ocean}" GroupName="VisualStyle" Margin="0,0,22,8" Foreground="{DynamicResource TextBrush}" Checked="VisualStyle_Checked"/><RadioButton x:Name="AuroraRadio" Content="{DynamicResource Aurora}" GroupName="VisualStyle" Margin="0,0,22,8" Foreground="{DynamicResource TextBrush}" Checked="VisualStyle_Checked"/><RadioButton x:Name="GraphiteRadio" Content="{DynamicResource Graphite}" GroupName="VisualStyle" Foreground="{DynamicResource TextBrush}" Checked="VisualStyle_Checked"/></WrapPanel><TextBlock Text="{DynamicResource VisualStyleHelp}" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/></StackPanel>
        </Border>
        <Border Background="{DynamicResource PanelBrush}" CornerRadius="18" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="20" Margin="0,0,0,16">
            <StackPanel><TextBlock Text="{DynamicResource PanelStyle}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/><StackPanel Orientation="Horizontal"><RadioButton x:Name="KeyboardModeRadio" Content="{DynamicResource KeyboardPanel}" GroupName="PanelMode" Margin="0,0,25,0" Foreground="{DynamicResource TextBrush}" Checked="PanelMode_Checked"/><RadioButton x:Name="LinearModeRadio" Content="{DynamicResource LinearPanel}" GroupName="PanelMode" Foreground="{DynamicResource TextBrush}" Checked="PanelMode_Checked"/></StackPanel><TextBlock Text="{DynamicResource InstantApply}" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/></StackPanel>
        </Border>
        <Border Background="{DynamicResource PanelBrush}" CornerRadius="18" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="20" Margin="0,0,0,16">
            <StackPanel><TextBlock Text="{DynamicResource BackgroundOpacity}" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="OpacityText" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,8"/><Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="OpacitySlider_ValueChanged"/></StackPanel>
        </Border>
        <Border Background="{DynamicResource PanelBrush}" CornerRadius="18" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="20" Margin="0,0,0,16">
            <StackPanel><TextBlock Text="{DynamicResource LinearLength}" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="LinearWidthText" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,8"/><Slider x:Name="LinearWidthSlider" Minimum="200" Maximum="1800" TickFrequency="20" ValueChanged="LinearWidthSlider_ValueChanged"/><TextBlock Text="{DynamicResource LinearLengthHelp}" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0"/></StackPanel>
        </Border>
        <Border Background="{DynamicResource PanelBrush}" CornerRadius="18" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="20" Margin="0,0,0,16">
            <StackPanel><TextBlock Text="{DynamicResource SystemComponents}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource SystemComponentsHelp}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,10"/><WrapPanel><CheckBox x:Name="MyComputerBox" Content="{DynamicResource MyComputer}" Foreground="{DynamicResource TextBrush}" Margin="0,0,22,8" Checked="SystemComponent_Changed" Unchecked="SystemComponent_Changed"/><CheckBox x:Name="DownloadsBox" Content="{DynamicResource Downloads}" Foreground="{DynamicResource TextBrush}" Margin="0,0,22,8" Checked="SystemComponent_Changed" Unchecked="SystemComponent_Changed"/><CheckBox x:Name="RecycleBinBox" Content="{DynamicResource RecycleBin}" Foreground="{DynamicResource TextBrush}" Margin="0,0,22,8" Checked="SystemComponent_Changed" Unchecked="SystemComponent_Changed"/></WrapPanel></StackPanel>
        </Border>
        <Border Background="{DynamicResource PanelBrush}" CornerRadius="18" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="20" Margin="0,0,0,16">
            <StackPanel><TextBlock Text="{DynamicResource IconContent}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/><CheckBox x:Name="ShowNamesBox" Content="{DynamicResource ShowIconNames}" Foreground="{DynamicResource TextBrush}" Checked="ShowNames_Changed" Unchecked="ShowNames_Changed"/><TextBlock Text="{DynamicResource ShowNamesHelp}" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/></StackPanel>
        </Border>
        <Border Background="{DynamicResource PanelBrush}" CornerRadius="18" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="20" Margin="0,0,0,16">
            <StackPanel><TextBlock Text="{DynamicResource ActivationHotkey}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource HotkeyHelp}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,12"/><StackPanel Orientation="Horizontal"><ComboBox x:Name="ModifierBox" Width="145" Padding="8" Margin="0,0,10,0"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#FF111827" FontWeight="SemiBold"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="＋" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox x:Name="KeyBox" Width="145" Padding="8"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#FF111827" FontWeight="SemiBold"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel></StackPanel>
        </Border>
        <Border Background="{DynamicResource PanelBrush}" CornerRadius="18" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="20" Margin="0,0,0,16">
            <StackPanel><TextBlock Text="{DynamicResource System}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/><CheckBox x:Name="StartupBox" Content="{DynamicResource Startup}" Foreground="{DynamicResource TextBrush}"/></StackPanel>
        </Border>
        <Border Background="{DynamicResource PanelBrush}" CornerRadius="18" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="20" Margin="0,0,0,16">
            <StackPanel><TextBlock Text="{DynamicResource PanelPosition}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource PanelPositionHelp}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,12"/><StackPanel Orientation="Horizontal"><RadioButton x:Name="RememberPositionRadio" Content="{DynamicResource RememberPosition}" GroupName="Position" Margin="0,0,25,0" Foreground="{DynamicResource TextBrush}"/><RadioButton x:Name="CenterPositionRadio" Content="{DynamicResource AlwaysCenter}" GroupName="Position" Foreground="{DynamicResource TextBrush}"/></StackPanel></StackPanel>
        </Border>
        <Border Background="{DynamicResource PanelBrush}" CornerRadius="18" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="20">
            <StackPanel><TextBlock Text="{DynamicResource VisibleKeys}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource VisibleKeysHelp}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,12"/>
                <ItemsControl x:Name="KeysList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Key}" IsChecked="{Binding IsVisible, Mode=TwoWay}" Width="56" Margin="3" Foreground="{DynamicResource TextBrush}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,10"><Button Content="{DynamicResource Cancel}" Click="Cancel_Click" Padding="20,9" Margin="0,0,10,0"/><Button Content="{DynamicResource SaveSettings}" Click="Save_Click" Padding="20,9" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0"/></StackPanel>
    </StackPanel></ScrollViewer>
</Window>
