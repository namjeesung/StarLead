<Window x:Class="StarLead.NotebookWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource NotebookTitle}" Width="1100" Height="720" MinWidth="780" MinHeight="520" WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <StackPanel Orientation="Horizontal">
                <Image Source="{DynamicResource LogoAsset}" Width="46" Height="46" Stretch="Uniform"/>
                <StackPanel Margin="12,0,0,0"><TextBlock Text="{DynamicResource Notebook}" FontSize="25" FontWeight="Bold"/><TextBlock Text="{DynamicResource NotebookSubtitle}" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="SelectionText" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <Button x:Name="FreeButton" Content="{DynamicResource FreeLayout}" Click="FreeMode_Click" Padding="15,8" Margin="0,0,8,0"/>
                <Button x:Name="AutoButton" Content="{DynamicResource AutoLayout}" Click="AutoMode_Click" Padding="15,8" Margin="0,0,8,0"/>
                <Button Content="{DynamicResource Arrange}" Click="Arrange_Click" Padding="15,8" Margin="0,0,8,0" Background="{DynamicResource AccentSoftBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource AccentBrush}"/>
                <Button Content="{DynamicResource New}" Click="New_Click" Padding="15,8" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="22" ClipToBounds="True">
            <ScrollViewer x:Name="BoardScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid x:Name="BoardSurface" MinWidth="900" MinHeight="560" Background="Transparent" MouseLeftButtonDown="Board_MouseDown">
                    <ItemsControl x:Name="NotesItems">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding X}"/><Setter Property="Canvas.Top" Value="{Binding Y}"/></Style></ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Width="170" Height="120" CornerRadius="16" Padding="13"
                                    MouseLeftButtonDown="Card_MouseDown" MouseMove="Card_MouseMove" MouseLeftButtonUp="Card_MouseUp" MouseRightButtonUp="Card_RightClick">
                                <Border.Style><Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ColorKey}" Value="Yellow"><Setter Property="Background" Value="#55FFC857"/></DataTrigger>
                                        <DataTrigger Binding="{Binding ColorKey}" Value="Blue"><Setter Property="Background" Value="#554DA3FF"/></DataTrigger>
                                        <DataTrigger Binding="{Binding ColorKey}" Value="Green"><Setter Property="Background" Value="#5548C78E"/></DataTrigger>
                                        <DataTrigger Binding="{Binding ColorKey}" Value="Pink"><Setter Property="Background" Value="#55FF6B9D"/></DataTrigger>
                                        <DataTrigger Binding="{Binding ColorKey}" Value="Purple"><Setter Property="Background" Value="#558C7BFF"/></DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderThickness" Value="3"/></DataTrigger>
                                    </Style.Triggers>
                                </Style></Border.Style>
                                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.13"/></Border.Effect>
                                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,0,23,0"/><TextBlock Text="★" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsPinned}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
                                    <TextBlock Grid.Row="1" Text="{Binding Content}" Margin="0,7,0,5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="50"/>
                                    <TextBlock Grid.Row="2" Text="{Binding ModifiedAt, StringFormat=MM-dd HH:mm}" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                                </Grid>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="EmptyHint" Text="{DynamicResource EmptyNotebook}" FontSize="18" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
